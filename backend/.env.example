# Backend environment template — copy to .env and fill in real values.
# Never commit the real .env file.

# HTTP port for the Express API (Render assigns PORT automatically).
PORT=5000

# development | production
NODE_ENV=development

# MongoDB connection string (Atlas or local). Keep this secret.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database-name>

# Random secret used to sign JWTs. Must be at least 32 characters.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Allowed frontend origin(s), comma separated. Used in production for CORS.
CLIENT_URL=http://localhost:5173

# Optional: password used by `npm run seed` for the demo accounts.
DEMO_PASSWORD=
